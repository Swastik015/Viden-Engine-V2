    "campaignBrief": {
      "version": "v0.4 draft",
      "author":  "Maya Chen - HCP Marketing",
      "date":    "20 May 2026",
      "sections": [
        { "num": "01", "heading": "Objective",            "content": "Drive a +2.4 pt share-of-voice lift for Vyepti vs the CGRP class among neurologists, headache specialists and high-prescribing PCPs. Activate the infusion referral pathway in PCP-treated patients with prior preventive failures. Reach 9,500 Tier 1+2 HCPs by 30 November 2026." },
        { "num": "02", "heading": "Strategic Positioning","content": "Reframe Vyepti from another preventive option to the preventive that starts working from Day 1. Lead with onset-of-action evidence from PROMISE-1 and PROMISE-2, supported by the 2-4 prior-failure positioning from DELIVER 2023. Pair every PCP-facing asset with infusion-site mapping." },
        { "num": "03", "heading": "Messaging Pillars",   "pillars": [
          { "id": "P1", "title": "Day 1 onset of preventive effect",         "color": "teal"  },
          { "id": "P2", "title": "Clinical reset for prior-failure patients", "color": "teal"  },
          { "id": "P3", "title": "Quarterly cadence + infusion access",       "color": "brand" }
        ]},
        { "num": "04", "heading": "Target Audience",     "content": "Primary: T1 KOLs (~140) and T2 high-volume neurologists (~580) for peer-led and Veeva CLM activation. Secondary: General neurologists (~15,480) via HCP portal and programmatic display. Tertiary: High-prescribing PCPs (~2,200) via email and infusion-site map." },
        { "num": "05", "heading": "KPIs", "kpis": [
          { "label": "SoV lift",           "target": "+2.4 pts", "by": "30 Nov 2026" },
          { "label": "HCPs reached",       "target": "9,500",    "by": "30 Nov 2026" },
          { "label": "Infusion referrals", "target": "+18%",      "by": "Q3 close"   },
          { "label": "Engagement rate",    "target": "3x+",       "by": "vs baseline" }
        ]}
      ]
